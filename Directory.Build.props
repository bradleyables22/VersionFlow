<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Bradley Ables</Authors>
    <Copyright>Copyright (c) 2026 Bradley Ables</Copyright>
    <Description>Strongly typed configuration-driven service and method version routing.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>VersionFlow-icon.png</PackageIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>

